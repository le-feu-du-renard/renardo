#ifndef SECRETS_H
#define SECRETS_H

// Credentials. **This file is the committed example; the real one is
// include/secrets.h and is gitignored.**
//
//   cp include/secrets.h.example include/secrets.h
//
// then fill it in. The firmware will not build without it, which is deliberate:
// a default that silently compiles is a default that eventually ships.
//
// Nothing else in the repository contains a credential, and nothing should. If
// a value belongs here it belongs nowhere else — see AGENTS.md, rule 7.

// ----- WiFi -----
#define WIFI_SSID "your-network"
#define WIFI_PASSWORD "your-password"

// ----- Grafana Cloud -----
//
// From the Grafana Cloud portal: whatever page hands out an
// OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_HEADERS pair for this
// stack's OTLP gateway (Connections -> OpenTelemetry, or a data source's own
// "Configuration Details" panel — the same values `otel-cli`/language SDKs
// would read from the environment).

// The OTLP gateway's base URL, e.g.
// "https://otlp-gateway-prod-gb-south-1.grafana.net/otlp" — GrafanaClient
// appends "/v1/metrics" itself, the same way an OTEL_EXPORTER_OTLP_ENDPOINT
// is used unsuffixed by every other OTLP exporter. Not a secret on its own,
// but kept beside the credential it is paired with so moving this board to
// another stack is a single file edit — the same reason INFLUX_HOST used to
// be separate from INFLUX_TOKEN.
#define GRAFANA_URL "https://otlp-gateway-prod-REGION.grafana.net/otlp"

// The whole Authorization header value, exactly as Grafana Cloud's portal
// hands it out: "Basic " followed by base64(instance_id:token). Grafana
// Cloud precomputes this — usually shown as OTEL_EXPORTER_OTLP_HEADERS'
// "Authorization=" value — so this board never needs to base64-encode
// anything itself, unlike the Basic Auth Prometheus remote_write would have
// needed. Never logged — not even truncated. See AGENTS.md, rule 7.
#define GRAFANA_AUTHORIZATION "Basic your-base64-instance-id-and-token"

// The OTLP gateway's PEM root CA certificate, pinned rather than trusted
// blind: this link runs over the public internet, unlike the old InfluxDB
// box on the LAN, and the header above travels in every request. Export it
// from the endpoint, e.g.:
//   openssl s_client -connect otlp-gateway-prod-REGION.grafana.net:443 \
//     -showcerts </dev/null 2>/dev/null \
//     | openssl x509 -outform PEM
// and take the *root*, not the leaf, if the chain returns more than one.
#define GRAFANA_CA_CERT \
  "-----BEGIN CERTIFICATE-----\n" \
  "your-ca-certificate-goes-here\n" \
  "-----END CERTIFICATE-----\n"

#endif // SECRETS_H
